{
  "name": "ResourceArticle",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "source_label": {
      "type": "string"
    },
    "date_published": {
      "type": "string",
      "format": "date"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_visible": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "category_id",
    "summary",
    "content",
    "date_published"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}